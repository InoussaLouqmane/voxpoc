TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GEMINI_API_KEY=
# Modèle Gemini Live pour la conversation vocale temps réel (optionnel)
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
# Voix Gemini Live à utiliser (optionnel, défaut: Aoede)
GEMINI_VOICE=Aoede
# Modèle Gemini pour la génération du résumé texte post-appel (optionnel)
GEMINI_TEXT_MODEL=gemini-3.6-flash
# URL publique ngrok du backend, ex: https://mon-nom.ngrok-free.app
PUBLIC_BACKEND_URL=
# URL du frontend déployé sur Vercel (pour CORS), ex: https://voxpoc.vercel.app
FRONTEND_URL=
PORT=3000
